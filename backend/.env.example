# Copy to backend/.env. Never commit the real file.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/techneeds
# Render Blueprint supplies MONGO_HOST, MONGO_USER and MONGO_PASSWORD instead.
# MONGO_DATABASE defaults to techneeds; an explicit MONGO_URI takes precedence.
JWT_SECRET=<long random string, e.g. `openssl rand -hex 32`>
PORT=8000

# First admin, created on boot if it does not exist (password >= 10 chars).
ADMIN_EMAIL=admin@techneeds.local
ADMIN_PASSWORD=

# Comma-separated frontend origins. Leave empty in development to allow all.
CORS_ORIGIN=

# AI profile (optional). With neither key set, the rules engine writes profiles.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# PROFILE_ENGINE=rules|gemini|claude

# Render Workflows (optional). Without these, profiles generate inside the API.
# Deployed: RENDER_API_KEY + RENDER_WORKFLOW_SLUG (the workflow service slug).
# Local:    RENDER_USE_LOCAL_DEV=true + RENDER_WORKFLOW_SLUG=local, with
#           `render workflows dev -- node workflows/main.js` running.
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=
